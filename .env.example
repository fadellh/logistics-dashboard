# Postgres connection string — standard wire protocol (drizzle-orm/node-postgres), so
# any Postgres works: Neon (from neon.tech project dashboard, or auto-filled via the
# Vercel Storage → Neon marketplace integration — use the pooled "-pooler" host on
# Vercel), a local Postgres, or any other Postgres host.
#
# Not read at all if you use `make compose-up` (see README's Docker section) — that path
# wires its own local Postgres automatically and ignores this value.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# DeepSeek API key — from platform.deepseek.com → API Keys
# Used via the OpenAI SDK with baseURL "https://api.deepseek.com" (lib/ai/client.ts)
DEEPSEEK_API_KEY="sk-..."

# Auth: two hardcoded credentials, no user table. Set these to whatever you want
# the owner/reviewer passwords to be — rotate independently as needed.
ADMIN_PASSWORD="change-me"
GUEST_PASSWORD="change-me-too"
# Random string, gates the session cookie (not a per-user secret — both roles get
# identical access, this just validates "did this request pass /login").
SESSION_SECRET="generate-a-long-random-string"
